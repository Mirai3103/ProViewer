<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Lets Macrobenchmark/Perfetto profile this non-debuggable build over adb shell. -->
        <profileable
            android:shell="true"
            tools:targetApi="q" />

        <!-- Shares benchmark result JSONs (Task 10's "Share JSON"): ACTION_SEND of files under
             filesDir/bench, exported=false so only the app's own grants reach them. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.benchfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/bench_paths" />
        </provider>
    </application>

</manifest>
